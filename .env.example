# Optional. Without any key below, Bookmark Brain uses a built-in local
# embedding model (hashed bag-of-words) so search and clustering work
# fully offline. Set one provider's key for noticeably better semantic
# search — either is fine, pick whichever you already have an account for.

# Option A: OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Option B: Gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.7-flash

# Optional. If you ever set both keys above, this picks which one wins
# ('openai' or 'gemini'). Leave unset to auto-detect (OpenAI takes
# priority if both are present). Set to 'local' to force offline mode
# even with a key configured.
EMBEDDING_PROVIDER=

PORT=3300
