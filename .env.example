# Optional. Without this, Bookmark Brain uses a built-in local embedding
# model (hashed bag-of-words) so search and clustering work fully offline.
# Set this to use real OpenAI embeddings for noticeably better semantic search.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional. Only used if OPENAI_API_KEY is set, to write nicer cluster labels.
OPENAI_CHAT_MODEL=gpt-4o-mini

PORT=3300
